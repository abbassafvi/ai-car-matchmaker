# Spec-kit's own security note: agent folders can hold credentials/local state
.claude/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Node
node_modules/
dist/

# Env / secrets -- .env.example is a template with no real values and
# must stay tracked; everything else matching .env* is excluded.
.env
.env.*
!.env.example
*.sqlite
# AsyncSqliteSaver (M3) runs the checkpointer in WAL mode, which writes
# these sidecars next to the db. They hold real session data, and "*.sqlite"
# does not match them -- caught by `git status` after the first live run.
*.sqlite-shm
*.sqlite-wal
*.db

# Frontend build artifacts
*.tsbuildinfo

# OS
.DS_Store
