# Copy to .env (gitignored) and fill in. Never commit real values.

# --- LLM provider -----------------------------------------------------
# Switching provider or model is config-only; no code changes needed.
#
# "google" uses the native Gemini client. Prefer it for any Gemini 3.x
# model: those are thinking models whose function calls carry a
# thought_signature that must be echoed back, and Gemini's OpenAI-
# compatibility endpoint drops it -- which breaks the second turn of every
# tool-using conversation with a 400. See agent/llm.py for details.
#
# Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash

# Note on quotas: the Gemini free tier allows only ~20 requests/day/model,
# which is enough for a smoke test but not for a live demo or a full eval
# run. Use a billed key, or spread load across models, for anything real.

# Any OpenAI-compatible provider works too, e.g. OpenRouter:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=anthropic/claude-sonnet-4.5

# --- Observability ----------------------------------------------------
# Use the docker-compose service name when running in Docker (compose sets
# this automatically); use localhost when running the backend natively.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:14317
