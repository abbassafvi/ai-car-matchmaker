# Copy to .env (gitignored) and fill in. Never commit real values.

# LLM provider: OpenRouter (OpenAI-compatible API), so any OpenRouter-hosted
# model works by changing OPENROUTER_MODEL -- no code changes needed.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Defaults to the docker-compose service name; override for local
# (non-docker) runs, e.g. http://localhost:14317
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:4317
